{
  "name": "opencode-terminal-headless",
  "version": "0.1.0",
  "description": "Agent Code's PTY headless adapter for the native OpenCode TUI: reads OpenCode's durable event log and live server into the provider event shape Agent Code consumes",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "vitest run --project core",
    "test:system": "vitest run --project system",
    "test:live": "vitest run --config vitest.live.config.ts --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "test:contract": "node scripts/check-test-contract.mjs",
    "census": "tsx scripts/census.mts",
    "probe:live": "tsx scripts/probe-live.mts",
    "check": "npm run test:contract && npm run typecheck && npm test && npm run test:package"
  },
  "peerDependencies": {
    "node-pty": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "node-pty": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
